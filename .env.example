# Copy to .env and adjust. Every value below is read by app/config.py.
ROADGUARD_ENV=development
ROADGUARD_DB_PATH=data/roadguard.sqlite3
ROADGUARD_MODEL_ARTIFACT=ml/artifacts/model.joblib
# When true, route analysis fails with model_unavailable if the artifact is absent.
ROADGUARD_REQUIRE_MODEL=false
ROADGUARD_OSRM_BASE_URL=https://router.project-osrm.org
ROADGUARD_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
ROADGUARD_PROVIDER_USER_AGENT=RoadGuardAI/0.1 (student project; contact: REQUIRES STUDENT INPUT)
ROADGUARD_PROVIDER_TIMEOUT_SECONDS=8
ROADGUARD_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ROADGUARD_COOKIE_SECURE=false
ROADGUARD_SESSION_TTL_SECONDS=43200
ROADGUARD_HAZARD_TTL_HOURS=24
ROADGUARD_ROUTE_RATE_PER_MINUTE=20
ROADGUARD_HAZARD_RATE_PER_HOUR=10
ROADGUARD_LOGIN_RATE_PER_MINUTE=5
